# =============================================================================
# School Management System — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Deployment environment
# ---------------------------------------------------------------------------
# Choices: local | dev | staging | prod
ENVIRONMENT=local

# SECURITY — generate a real key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<your-secret-key-here>

# Enable debug mode (never True in production)
DEBUG=False

# JSON list of allowed host/domain names
ALLOWED_HOSTS=["localhost", "127.0.0.1", "yourdomain.com"]

# JSON list of CORS origins (for mobile apps / frontend dev server)
CORS_ALLOWED_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000", "http://10.0.2.2:8000"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Choices: POSTGRES | SQLITE (default: SQLITE)
# When using PostgreSQL, also set DATABASE_USER, DATABASE_PASSWORD, DATABASE_HOST, DATABASE_PORT
DATABASE_ENGINE=POSTGRES
DATABASE_NAME=school_management
DATABASE_USER=<postgres-user>
DATABASE_PASSWORD=<postgres-password>
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=600
DATABASE_CONN_HEALTH_CHECKS=False
DATABASE_ATOMIC_REQUESTS=False

# ---------------------------------------------------------------------------
# Internationalization
# ---------------------------------------------------------------------------
LANGUAGE_CODE=id-ID
TIME_ZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# School data YAML (path relative to project root, or absolute)
# ---------------------------------------------------------------------------
SCHOOL_DATA_PATH=school-data.yaml

# ---------------------------------------------------------------------------
# Redis (used in production)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# Email (used in production)
# ---------------------------------------------------------------------------
EMAIL_HOST=<smtp-host>
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
